# Emotional Well-being Tracker - Backend Configuration
PORT=5000

# Supabase Cloud Backend Configuration
# Obtain these from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Menaka AI & Gemini LLM Configuration
# Obtain key from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Text-to-Speech (TTS) Provider Configuration
# Supported providers: 'google' (default, uses Cloud TTS with ta-IN female voice), 'elevenlabs', or 'browser'
TTS_PROVIDER=google
TTS_API_KEY=your-tts-api-key-here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Feature Flags (JSON string)
# Keep cost-controlled AI generative music/video flags disabled by default
FEATURE_FLAGS={"ai_music":false,"ai_video":false}
